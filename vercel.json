{
  "routes": [
    { "src": "^/$", "has": [{ "type": "host", "value": "bookjosh.puroflowmedia.com" }], "dest": "/josh/index.html" },
    { "src": "^/(?!josh/)(.*)$", "has": [{ "type": "host", "value": "bookjosh.puroflowmedia.com" }], "dest": "/josh/$1" },
    { "src": "^/$", "has": [{ "type": "host", "value": "booksteven.puroflowmedia.com" }], "dest": "/steven/index.html" },
    { "src": "^/(?!steven/)(.*)$", "has": [{ "type": "host", "value": "booksteven.puroflowmedia.com" }], "dest": "/steven/$1" }
  ]
}
