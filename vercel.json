{
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bookjosh.puroflowmedia.com"
        }
      ],
      "destination": "/josh/index.html"
    },
    {
      "source": "/:path((?!josh/).*)",
      "has": [
        {
          "type": "host",
          "value": "bookjosh.puroflowmedia.com"
        }
      ],
      "destination": "/josh/:path"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "booksteven.puroflowmedia.com"
        }
      ],
      "destination": "/steven/index.html"
    },
    {
      "source": "/:path((?!steven/).*)",
      "has": [
        {
          "type": "host",
          "value": "booksteven.puroflowmedia.com"
        }
      ],
      "destination": "/steven/:path"
    }
  ]
}