{
 "routes": [
  {
   "src": "^/$",
   "has": [
    {
     "type": "host",
     "value": "bookjosh.puroflowmedia.com"
    }
   ],
   "dest": "/josh/index.html"
  },
  {
   "src": "^/(?!josh/)(.*)$",
   "has": [
    {
     "type": "host",
     "value": "bookjosh.puroflowmedia.com"
    }
   ],
   "dest": "/josh/$1"
  },
